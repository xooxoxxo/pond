# Copy to .env next to compose.yaml, chmod 600, fill in. Never commit .env.
# Required: the context name this Pond serves.
MAILBOX_CONTEXT=personal
# Required: the zone of the nightly backup and of capture dates (any IANA zone)
TZ=Etc/UTC
# Optional: the public Pond link base; each ask then gets "📋 Open in Hook" and POST /asks returns openUrl
# MAILBOX_RELAY_OPEN_BASE=https://pond.example/i
# For device invites, set the external HTTPS origin your clients reach.
# MAILBOX_PUBLIC_ORIGIN=https://pond.example
# Telegram is optional. Set both values below to enable it.
# TELEGRAM_BOT_TOKEN=   # bot token from @BotFather
# MAILBOX_OWNER_ID=     # owner's numeric Telegram user ID
# With Telegram enabled, full (default) accepts answers there. In alert mode, answer in Hook.
# MAILBOX_TELEGRAM_MODE=full
# Optional: capture owner texts into a Central Time install (both or neither); never commit the token
# MAILBOX_CT_URL=http://host.docker.internal:8787
# MAILBOX_CT_TOKEN=
# Optional: the token Central Time core presents on POST /notify (64 hex)
# MAILBOX_NOTIFY_TOKEN=
# Optional: the host port compose publishes (default 8790), e.g. for a second Pond on the same host
# MAILBOX_HOST_PORT=8796
# Optional: the image tag compose builds and runs (default pond:local); give a second Pond its own
# MAILBOX_IMAGE=pond:household
# Only if host.docker.internal does not reach the host from inside the container: the host's LAN address
# MAILBOX_HOST_GATEWAY=
# Optional: 0 drops the "Open asks: N" line from the morning brief; unset keeps it
# MAILBOX_BRIEF_ASKS=0
# Optional (Pond 1.14.0): turns on Ask about this, answered by Claude Haiku 5.5. The ask's text and its
# brief go to Anthropic's API when the owner asks. One of the two; never commit the key
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=/backups/anthropic-api-key
